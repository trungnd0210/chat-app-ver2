# ====== Supabase ======
# Lấy 2 giá trị này tại: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Lưu ý:
# - Đây là các biến công khai (NEXT_PUBLIC_*), an toàn để lộ ở phía client.
# - Việc bảo mật dữ liệu được đảm bảo bằng Row Level Security (RLS) trong Postgres.
# - Khi deploy lên Vercel, thêm 2 biến này trong: Project Settings > Environment Variables.
# - (Tùy chọn) URL + publishable key đã được nhúng sẵn trong code nên có thể bỏ trống.

# ====== Web Push (thông báo khi app đã đóng) — đặt trên Vercel ======
# Khóa VAPID công khai đã nhúng sẵn trong code; chỉ điền nếu muốn dùng khóa riêng
# (tạo bằng: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# BẮT BUỘC để gửi push (KHÔNG commit, chỉ đặt trên Vercel):
VAPID_PRIVATE_KEY=
# Secret key của Supabase (server-side, để truy vấn người nhận khi gửi push):
SUPABASE_SERVICE_ROLE_KEY=
# (Tùy chọn) chuỗi bí mật để xác thực webhook gọi từ Supabase:
PUSH_WEBHOOK_SECRET=
